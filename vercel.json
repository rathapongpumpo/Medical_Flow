{
    "version": 2,
    "builds": [
        { "src": "public/index.php", "use": "vercel-php@0.6.2" },
        { "src": "public/assets/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/assets/(.*)", "dest": "/public/assets/" },
        { "src": "/(.*)", "dest": "/public/index.php" }
    ]
}
